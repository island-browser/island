[Desktop Entry]
Version=1.0
Type=Application
Name=Island
GenericName=Web Browser
Comment=Browse the web with spaces, split view, and a built-in agent
Exec=/opt/island-browser/island_browser %U
Icon=island-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=island_browser
